# ============================================================
# YOJANTA — Environment Variables Template
# ============================================================
# HOW TO USE:
# 1. Copy this file and rename it to .env
# 2. Replace every value that says "your_..._here" with real values
# 3. NEVER commit your actual .env file to GitHub
# 4. This .env.example file IS safe to commit — it has no real secrets
# ============================================================


# ------------------------------------------------------------
# SERVER CONFIGURATION
# ------------------------------------------------------------

# Port the backend server runs on
PORT=5000

# Environment: development | production
NODE_ENV=development


# ------------------------------------------------------------
# DATABASE — MongoDB
# ------------------------------------------------------------

# Option A: Local MongoDB (for development)
MONGO_URI=mongodb://localhost:27017/yojanta

# Option B: MongoDB Atlas (free cloud database)
# Get this from: https://cloud.mongodb.com
# Steps: Create cluster → Connect → Drivers → Copy connection string
# MONGO_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/yojanta?retryWrites=true&w=majority


# ------------------------------------------------------------
# AUTHENTICATION — JWT
# ------------------------------------------------------------

# Secret key used to sign JWT tokens
# Use a long random string — minimum 32 characters
# Generate one at: https://randomkeygen.com
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters

# How long tokens stay valid before expiring
# Examples: 1h, 24h, 7d, 30d
JWT_EXPIRES_IN=24h


# ------------------------------------------------------------
# EXTERNAL API — data.gov.in
# ------------------------------------------------------------

# API key for fetching government scheme data
# Register free at: https://data.gov.in/user/register
# After registering: Profile → API Key
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# Base URL for data.gov.in (do not change)
DATA_GOV_IN_BASE_URL=https://api.data.gov.in/resource


# ------------------------------------------------------------
# CRON JOB — Data Sync Schedule
# ------------------------------------------------------------

# When to run the scheme sync job (cron syntax)
# Default: every day at midnight
# Format: second minute hour day month weekday
# Examples:
#   0 0 * * *     = every day at midnight
#   0 */6 * * *   = every 6 hours
#   0 0 * * 1     = every Monday at midnight
SYNC_CRON_SCHEDULE=0 0 * * *


# ------------------------------------------------------------
# FRONTEND URL (for CORS)
# ------------------------------------------------------------

# The URL where your React frontend is running
# Development:
FRONTEND_URL=http://localhost:3000

# Production (replace with your actual deployed frontend URL):
# FRONTEND_URL=https://your-app.vercel.app


# ------------------------------------------------------------
# OPTIONAL — Email Notifications (Future Feature)
# ------------------------------------------------------------

# Nodemailer SMTP config (for deadline reminders)
# Get from Gmail: Settings → Security → App Passwords
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_gmail_app_password_here
# EMAIL_FROM=Yojanta <your_email@gmail.com>


# ============================================================
# QUICK SETUP CHECKLIST:
# ============================================================
# [ ] Copy this file → rename to .env
# [ ] Set MONGO_URI (local or Atlas)
# [ ] Set JWT_SECRET (random 32+ char string)
# [ ] Set DATA_GOV_IN_API_KEY (from data.gov.in)
# [ ] Confirm .env is listed in your .gitignore
# [ ] Run: cd backend && npm run dev
# ============================================================
